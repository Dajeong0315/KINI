# 비밀값
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]

# 실행 중 생기는 파일 (사진·결과·재고·전송 대기열, 사용자 이름표)
captures/
user_labels.json
dummy/
tests/_tmp/

# 자동으로 내려받는 모델 파일 (수십~수백 MB)
models/
weights/
*.pt
*.ts

# 학습 기록·특징 캐시·로그
runs/
*.log

# VS Code 실행 설정은 README 의 실행 방법과 짝이라 포함 (KINI 루트 .gitignore 의 .vscode/ 제외를 이 폴더에서만 해제)
!.vscode/
.vscode/*
!.vscode/launch.json
