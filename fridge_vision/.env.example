# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 키를 넣으세요. (.env 는 절대 공유·업로드하지 마세요)
OPENAI_API_KEY=sk-여기에_키_입력
OPENAI_MODEL=gpt-4o-mini
# 응답 속도를 높이고 싶으면 low 로 지정 (비우면 모델 기본값)
OPENAI_REASONING_EFFORT=

# YOLO 인식 방식: yoloe_openvocab(새 방식: 원본 YOLOE + CLIP 재확인 + 포장 OCR) / kaggle(예전 방식 그대로)
DETECTOR_BACKEND=yoloe_openvocab
# 포장 식품 라벨: ocr_name(OCR 이름을 품목으로) / generic(packaged_food 하나, 이름은 로그에만)
PACKAGE_LABEL_MODE=ocr_name

# Supabase 고내 재고 DB (비우면 연동 안 함). DB 만들기: supabase/schema.sql
# 대시보드 → Project Settings → API 에서 복사. service_role 키는 이 PC 의 .env 에만 두세요 (GitHub·iPad 코드 금지).
SUPABASE_URL=https://프로젝트ID.supabase.co
SUPABASE_KEY=
# 재고 확인을 이 프로그램(local: 자동 반영·y/n)에서 할지, iPad(ipad: pending 으로만 저장)에서 할지
SUPABASE_CONFIRM_MODE=local
