# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 키를 넣으세요. (.env 는 절대 공유·업로드하지 마세요)
OPENAI_API_KEY=sk-여기에_키_입력
OPENAI_MODEL=gpt-4o-mini
# 응답 속도를 높이고 싶으면 low 로 지정 (비우면 모델 기본값)
OPENAI_REASONING_EFFORT=

# Supabase 고내 재고 테이블 (비우면 연동 안 함). 테이블 만들기: supabase/fridge_food.sql
# 대시보드 → Project Settings → API 에서 복사. service_role 키는 이 PC 의 .env 에만 두세요.
SUPABASE_URL=https://프로젝트ID.supabase.co
SUPABASE_KEY=
SUPABASE_TABLE=fridge_food
