{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "0. 기본 실행 (h265 영상 + YOLO, Unknown 이름 입력)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "1. 더미 영상 만들기",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/make_dummy_video.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "2. 더미 영상 + MOCK 인식 (API 키 불필요)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--source", "dummy/fridge_demo.mp4", "--mock"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "3. 더미 영상 + YOLO 인식",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--source", "dummy/fridge_demo.mp4"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4. 액션캠(카메라 0번, 없으면 실사 영상) + YOLO 인식",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--source", "0"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "5. 사진 2장 비교 (더미 사진)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--compare", "dummy/stills/step0_closed.jpg", "dummy/stills/step1_closed.jpg"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "6. 실제 영상 파일 + YOLO 인식",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--source", "C:/Users/aicam/Videos/video_preview_h265.mp4"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "7. 실제 영상에서 뽑은 사진 2장 비교",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--compare", "samples/real_before.jpg", "samples/real_after.jpg"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
