# 실제 값은 로컬 .env에만 입력하고 저장소에 커밋하지 마세요.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FOODSAFETY_KOREA_API_KEY=
DATA_GO_KR_SERVICE_KEY=
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 추천 설명은 로컬 고정 문구 사용. Ollama 보조 검사/OpenAI 시험 호출: 0회, USD 0.
KINI_USE_OPENAI=0
# 현재 미사용. 키 등록은 필요하지 않으며 실제 값은 서버의 보호된 설정에만 둡니다.
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=
# Explicit setup/migration is required before enabling meal-scoped feedback.
KINI_B_MEAL_FEEDBACK_ENABLED=0
KINI_MEAL_FEEDBACK_OPTIONS_FILE=
LOCAL_STT_MODEL=small
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8
LOCAL_STT_MODEL_DIR=models/stt
LOCAL_TTS_MODEL_DIR=models/tts
LOCAL_TTS_VOICE=ko_KR-kss-medium

# Optional, reserved for future read-only external search
TAVILY_API_KEY=
# Local synthetic verification backend. Production uses PostgreSQL/Supabase.
KINI_DB_BACKEND=sqlite
KINI_DB_PATH=
KINI_DATABASE_URL=
# Use a non-exposed schema for cloud private data. Default public is local compatibility only.
KINI_DB_SCHEMA=public
KINI_DB_CONNECT_TIMEOUT=5
# Disable demo family/health seed in private databases.
KINI_SEED_DEMO=0
# Server only. Never put a secret key in browser JavaScript.
SUPABASE_URL=https://zyjrwychceuxxfdproev.supabase.co
SUPABASE_SECRET_KEY=
# memory works without Docker. Select redis for a running local Redis server.
KINI_CACHE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
# app: existing local/private catalog; supabase: read existing public catalog.
# Enable only after private migration 009 and restricted public SELECT grants.
KINI_PUBLIC_CATALOG_BACKEND=app
