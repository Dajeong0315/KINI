# /etc/kini/server.env -- root owned, chmod 600. Never commit actual values.
# API address is intentionally absent: reverse proxy/Tailscale is configured later.
KINI_DB_BACKEND=postgres
KINI_DB_SCHEMA=kini_private
KINI_DATABASE_URL=
# Copy a direct/session pooler connection from Dashboard > Connect.
# URL must include sslmode=verify-full and sslrootcert=/etc/kini/supabase-ca.crt
KINI_DB_CONNECT_TIMEOUT=5
KINI_SEED_DEMO=0
KINI_CACHE_BACKEND=memory
SUPABASE_URL=https://zyjrwychceuxxfdproev.supabase.co
SUPABASE_SECRET_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_NO_CLOUD=1
KINI_USE_OPENAI=0
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
FLASK_DEBUG=0
