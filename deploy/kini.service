[Unit]
Description=KINI API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kini
Group=kini
WorkingDirectory=/opt/kini
EnvironmentFile=/etc/kini/server.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/kini/.venv/bin/python scripts/check_server_db.py
ExecStart=/opt/kini/.venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 1 --threads 2 --timeout 120 --error-logfile - app.main:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/kini/output

[Install]
WantedBy=multi-user.target
