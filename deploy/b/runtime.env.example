# Copy to /etc/kini-b/runtime.env; owner root:kini-b, mode 0640.
# Explicit FAKE external AI + real internal inspector; no implicit fallback.
KINI_B_AI_MODE=synthetic-ollama
KINI_B_STORAGE=synthetic-sqlite
KINI_DB_BACKEND=sqlite
KINI_DB_PATH=/var/lib/kini-b/synthetic.sqlite3
KINI_SEED_DEMO=0
KINI_B_DEADLINE_SECONDS=15
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NO_CLOUD=1
LANGCHAIN_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
KINI_USE_OPENAI=0
KINI_CACHE_BACKEND=memory
# Schema/runtime grants first. Disabled feedback never changes B readiness.
KINI_B_MEAL_FEEDBACK_ENABLED=0
KINI_MEAL_FEEDBACK_OPTIONS_FILE=/etc/kini-b/meal-feedback-options.v1.json
# real mode additionally requires reviewed project/balance, approved key/model,
# KINI_B_EXTERNAL_APPROVED=1; no secret belongs in this example.
